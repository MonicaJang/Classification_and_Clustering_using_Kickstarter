   "source": [
    "#### Silhouette Scores\n",
    "For time efficiency, I utilize samples (size of 10,000) here."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "d8a45f20",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 900x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from sklearn.metrics import silhouette_score \n",
    "\n",
    "k_range_sil = range(2, 16)\n",
    "silhouette_scores = []\n",
    "\n",
    "for k in k_range_sil:\n",
    "    kmeans_temp = KMeans(n_clusters=k, n_init='auto', random_state=42)\n",
    "    kmeans_temp.fit(df)\n",
    "    score = silhouette_score(df, kmeans_temp.labels_, sample_size=10000, random_state=42)  \n",
    "    silhouette_scores.append(score)\n",
    "    \n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
    "sns.lineplot(x=list(k_range_sil), y=silhouette_scores, marker='o')\n",
    "plt.title('Silhouette Score to Find Optimal K')\n",
    "plt.xlabel('Number of Clusters (K)')\n",
    "plt.ylabel('Silhouette Score')\n",
    "plt.grid(True, linestyle='--', alpha=0.6)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8c06de8d",
   "metadata": {},
   "source": [
