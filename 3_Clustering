   "cell_type": "code",
   "execution_count": 6,
   "id": "fec894b4",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['name_len'] = df['name'].fillna('').apply(len)\n",
    "df['blurb_len'] = df['blurb'].fillna('').apply(len)\n",
    "\n",
    "# We drop used columns\n",
    "df = df.drop(columns=['name', 'blurb'])"
   ]
