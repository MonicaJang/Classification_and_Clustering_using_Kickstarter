   "source": [
    "#### Standardize \"Goal\" Based on USD"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e0af6ec1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Use static_usd_rate for goal\n",
    "df['goal_usd_static'] = df['goal'] * df['static_usd_rate']\n",
    "\n",
    "# As we use static_rate, we drop fx_rate and used columns\n",
    "df = df.drop(columns=['goal', 'static_usd_rate', 'fx_rate'])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1139fe37",
   "metadata": {},
   "source": [
    "#### Campaign, Preparation Duration Calculation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "ac6b1de0",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['campaign_duration_days'] = (df['deadline'] - df['launched_at']) / (24*3600)\n",
    "df['preparation_duration_days'] = (df['launched_at'] - df['created_at']) / (24*3600)\n",
    "\n",
    "# We drop used columns\n",
    "df = df.drop(columns=['deadline', 'launched_at', 'created_at'])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7c12b6bf",
   "metadata": {},
   "source": [
