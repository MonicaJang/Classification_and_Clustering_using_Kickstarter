   "source": [
    "## K-Means Clustering"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "152eaa22",
   "metadata": {},
   "source": [
    "#### K-Means Labeling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "a13e5d5a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([11,  0, 14, ...,  2, 14,  4], dtype=int32)"
      ]
     },
     "execution_count": 18,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "from sklearn.cluster import KMeans\n",
    "\n",
    "k_range = range(2, 16) \n",
    "inertia_values = []   # empty list to add inertia values for each K\n",
    "\n",
    "for k in k_range:\n",
    "    kmeans = KMeans(n_clusters=k, \n",
    "                    n_init='auto', \n",
    "                    random_state=42)\n",
    "    kmeans.fit(df)\n",
    "    inertia_values.append(kmeans.inertia_)\n",
    "    \n",
    "kmeans.labels_"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b32e9933",
   "metadata": {},
   "source": [
